`default_nettype none

module tt_um_eee703128_24100556 (
    input  wire [7:0] ui_in,
    output wire [7:0] uo_out,
    input  wire [7:0] uio_in,
    output wire [7:0] uio_out,
    output wire [7:0] uio_oe,
    input  wire       ena,
    input  wire       clk,
    input  wire       rst_n
);

    reg [7:0] quotient;reg busy;
reg start_d;
reg error_div0;
reg result_ready    reg [4:0] remainder;
    reg [3:0] divisor;
    reg [3:0] count;
    reg busy;
    reg start_d;
    reg error_div0;

    wire start_pulse = uio_in[4] & ~start_d;
    wire [4:0] shifted_remainder = {remainder[3:0], quotient[7]};
    wire subtract_ok = shifted_remainder >= {1'b0, divisor};
    wire [4:0] next_remainder =
        subtract_ok
        ? shifted_remainder - {1'b0, divisor}
        : shifted_remainder;
    wire [7:0] next_quotient = {quotient[6:0], subtract_ok};

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            quotient   <= 8'b0;
            remainder  <= 5'b0;
            divisor    <= 4'b0;
            count      <= 4'b0;
            busy       <= 1'b0;
            start_d    <= 1'b0;
            error_div0 <= 1'b0;
        end else begin
            start_d <= uio_in[4];

            if (start_pulse && !busy && ena) begin
                quotient   <= ui_in;
                remainder  <= 5'b0;
                divisor    <= uio_in[3:0];
                count      <= 4'b0;
                error_div0 <= (uio_in[3:0] == 0);

                if (uio_in[3:0] == 0) begin
                    quotient  <= 8'b0;
                    remainder <= 5'b0;
                    busy      <= 1'b0;
                end else begin
                    busy <= 1'b1;
                end
            end else if (busy) begin
                quotient  <= next_quotient;
                remainder <= next_remainder;

                if (count == 4'd7)
                    busy <= 1'b0;
                else
                    count <= count + 1'b1;
            end
        end
    end

    assign uo_out = quotient;
    assign uio_out = {3'b000, error_div0, remainder[3:0]};
    assign uio_oe = 8'b00001111;

endmodule

`default_nettype wire
